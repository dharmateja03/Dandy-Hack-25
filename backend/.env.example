# API Settings
API_VERSION=0.1.0
APP_NAME=MCP - Model Context Protocol

# Database (Docker Compose)
DATABASE_URL=postgresql://mcp_user:mcp_password@postgres:5432/mcp_db

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=mcp_context
EMBEDDING_DIMENSION=768

# LLM Configuration - Gemini (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Slack Configuration (Required for bot)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Jira Configuration (Optional - for Jira sync)
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# GitHub Configuration (Optional - for GitHub sync)
# GITHUB_TOKEN=ghp_your-github-token
# GITHUB_ORG=your-org-name
# GITHUB_REPOS=repo1,repo2,repo3

# Linear Configuration (Optional - for Linear sync)
# LINEAR_API_KEY=your-linear-api-key
# LINEAR_TEAM_ID=your-linear-team-id

# Google Calendar Configuration (Optional - for meeting tracking)
# GOOGLE_CALENDAR_CREDENTIALS=/path/to/credentials.json
# GOOGLE_CALENDAR_TOKEN=/path/to/token.json

# Scheduling
STANDUP_TIME=09:00
REMINDER_INTERVAL_HOURS=6

# Feature Flags (set to true to enable)
ENABLE_JIRA_SYNC=false
ENABLE_GITHUB_SYNC=false
ENABLE_LINEAR_SYNC=false
ENABLE_CALENDAR_SYNC=false
ENABLE_VOICE=false
